{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "powershell -NoProfile -File ${workspaceFolder}/utils/vsmake.ps1 ${file}",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "powershell -NoProfile -File ${workspaceFolder}/utils/vsmake.ps1 ${file} clean",
            "problemMatcher": []
        },
        {
            "label": "Program (DFU)",
            "type": "shell",
            "command": "powershell -NoProfile -File ${workspaceFolder}/utils/vsmake.ps1 ${file} program-dfu",
            "problemMatcher": []
        },
        {
            "label": "Program (Debug Probe)",
            "type": "shell",
            "command": "powershell -NoProfile -File ${workspaceFolder}/utils/vsmake.ps1 ${file} program",
            "problemMatcher": []
        },
        {
            "label": "Re-Build",
            "type": "shell",
            "command": "powershell -NoProfile -File ${workspaceFolder}/utils/vsmake.ps1 ${file} clean; powershell -NoProfile -File ${workspaceFolder}/utils/vsmake.ps1 ${file}",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
            }
        }
    ]
}